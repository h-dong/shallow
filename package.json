{
  "name": "@hdong/shallow",
  "version": "0.1.3",
  "description": "A library for testing React components like they are pure functions.",
  "keywords": [
    "component",
    "react",
    "shallow",
    "testing",
    "unit test"
  ],
  "homepage": "https://github.com/h-dong/shallow#readme",
  "bugs": {
    "url": "https://github.com/h-dong/shallow/issues"
  },
  "license": "MIT",
  "author": "Hao Dong <hey@hao.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h-dong/shallow.git"
  },
  "files": [
    "dist",
    "src/vitest/vitest.d.ts",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./src/vitest/vitest.d.ts",
      "import": "./dist/vitest/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "fix": "pnpm run format:fix && pnpm run lint:fix",
    "format": "oxfmt . --check",
    "format:check": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint . --tsconfig tsconfig.json",
    "lint:fix": "oxlint . --tsconfig tsconfig.json --fix",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test:ci && pnpm run build",
    "publish:npm": "pnpm publish --access public",
    "test": "vitest",
    "test:ci": "vitest --run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "4.1.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "react": "^19.2.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}
